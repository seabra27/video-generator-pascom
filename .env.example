# Copie este arquivo para ".env" (mesma pasta) e preencha os valores reais.
# O arquivo ".env" nunca deve ser commitado — já está no .gitignore.

# Fase 3 — aistudio.google.com/apikey (gratuito, sem cartão de crédito) —
# usada para dividir a transcrição em blocos e gerar os prompts de imagem
# de cada cena.
GEMINI_API_KEY=

# Fase 4 — dash.cloudflare.com (gratuito, sem cartão de crédito, tier
# Workers AI) — usada para gerar as imagens de fundo de cada bloco (Flux).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
