# Copie este arquivo para ".env" (mesma pasta) e preencha os valores reais.
# O arquivo ".env" nunca deve ser commitado — já está no .gitignore.

# Fase 3 — console.anthropic.com — usada para dividir a transcrição em blocos
# e gerar os prompts de imagem de cada cena.
ANTHROPIC_API_KEY=

# Fase 4 — fal.ai — usada para gerar as imagens de fundo de cada bloco.
FAL_KEY=
